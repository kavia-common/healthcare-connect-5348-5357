# ===================================
# Healthcare Connect Backend API
# Environment Configuration Template
# ===================================

# MongoDB Configuration
# ----------------------
# MongoDB connection URI - replace with your actual connection string
# Format: mongodb://[username:password@]host[:port]/[database]
MONGO_URI=mongodb://localhost:27017/healthcare_db

# MongoDB database name
MONGO_DB=healthcare_db

# JWT Authentication Configuration
# ---------------------------------
# Secret key for signing JWT tokens - MUST be changed in production
# Generate a secure random string: openssl rand -hex 32
JWT_SECRET=your-secret-key-change-this-in-production

# JWT algorithm for token signing (HS256 recommended for symmetric signing)
JWT_ALGORITHM=HS256

# Access token expiration time in minutes (default: 30 minutes)
ACCESS_TOKEN_EXPIRES_MINUTES=30

# JWT clock skew tolerance in seconds to handle minor time differences
# between client and server (default: 5 seconds)
JWT_CLOCK_SKEW_SECONDS=5

# CORS Configuration
# ------------------
# Comma-separated list of allowed origins for Cross-Origin Resource Sharing
# Use "*" to allow all origins (not recommended for production)
# Example: https://example.com,https://app.example.com
CORS_ORIGINS=*

# Backend Base URL
# ----------------
# Base URL where this backend API is accessible
# Used for generating links and webhooks
BACKEND_BASE_URL=http://localhost:8000

# Logging Configuration (Optional)
# ---------------------------------
# LOG_LEVEL=INFO
