# Backend environment variables example for Healthcare Connect API
# Copy to .env and customize for your environment.

# MongoDB connection
MONGO_URI=mongodb://appuser:dbuser123@localhost:5000/?authSource=admin
MONGO_DB=myapp

# JWT configuration
JWT_SECRET=change_me_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60

# CORS origins
# Comma-separated list of allowed origins. Use "*" to allow any origin.
# Common local defaults are automatically added in code (localhost:3000/5173 and appetize.io).
CORS_ORIGINS=*

