# MongoDB Configuration
# Connection URI to MongoDB instance with authentication
# For local development, use the credentials from the database setup
MONGO_URI=mongodb://appuser:dbuser123@localhost:5001/myapp?authSource=admin
MONGO_DB=myapp

# JWT Configuration
# CRITICAL: Generate a secure random secret for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-change-in-production-use-secure-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_CLOCK_SKEW_SECONDS=30

# CORS Configuration
# Comma-separated list of allowed origins
# Include both ports for Flutter web/mobile testing
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Backend Configuration
# Base URL for the backend API
BACKEND_BASE_URL=http://localhost:3001
