# MongoDB Configuration
# Connection URI to MongoDB instance
MONGO_URI=mongodb://localhost:27017/healthcare?authSource=admin
MONGO_DB=healthcare

# JWT Configuration
# CRITICAL: Generate a secure random secret for production
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_CLOCK_SKEW_SECONDS=30

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://appetize.io

# Backend Configuration
BACKEND_BASE_URL=http://localhost:8000
