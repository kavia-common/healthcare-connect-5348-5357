# Example environment variables for Healthcare Backend API (FastAPI)

# MongoDB settings
MONGODB_URI=mongodb://localhost:5001
DB_NAME=healthcare

# JWT settings
JWT_SECRET=replace_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS origins (comma-separated)
# Include your Flutter web origin (if using Flutter web) or other frontends
CORS_ORIGINS=http://localhost:3000

# Optional: Path to indexes.json (otherwise auto-resolved)
# INDEXES_FILE=/absolute/path/to/indexes.json
