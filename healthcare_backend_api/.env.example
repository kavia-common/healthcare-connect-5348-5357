# MongoDB connection
MONGODB_URI=mongodb://localhost:27017
DB_NAME=healthcare

# JWT configuration
JWT_SECRET=please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS configuration: comma-separated list of allowed origins
# Example for Flutter web dev: http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:3000

# Optional: Override path to indexes.json (defaults to sibling healthcare_database path if available)
# INDEXES_FILE=/absolute/or/relative/path/to/indexes.json
